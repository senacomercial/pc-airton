# Production Environment Variables
# Copy this file to .env and fill in real values on Railway

# Database (Railway provides this automatically)
DATABASE_URL=postgresql://user:password@host:5432/railway

# Redis (Railway provides this automatically)
REDIS_URL=redis://user:password@host:6379

# JWT Secrets (generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
JWT_SECRET=your_jwt_secret_here_make_it_very_random
JWT_REFRESH_SECRET=your_jwt_refresh_secret_here_make_it_very_random
JWT_EXPIRATION=3600
JWT_REFRESH_EXPIRATION=604800

# Server
NODE_ENV=production
PORT=3000
LOG_LEVEL=log

# CORS
FRONTEND_URL=https://your-frontend.vercel.app

# Encryption (for message encryption)
ENCRYPTION_ALGORITHM=aes-256-gcm

# Optional: Payment Processing
# STRIPE_SECRET_KEY=sk_live_...
# STRIPE_WEBHOOK_SECRET=whsec_...

# Optional: Email/Notifications
# SENDGRID_API_KEY=...
# SENDGRID_FROM_EMAIL=...

# Optional: AWS S3 (for file uploads)
# AWS_REGION=us-east-1
# AWS_S3_BUCKET=your-bucket
# AWS_ACCESS_KEY_ID=...
# AWS_SECRET_ACCESS_KEY=...
